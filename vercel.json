{
  "functions": {
    "api/chat.js": {
      "maxDuration": 60,
      "includeFiles": "prompts/**"
    }
  },
  "alias": ["eimemes-chat-ai.vercel.app"],
  "rewrites": [
    { "source": "/reset-password", "destination": "/reset-password.html" },
    { "source": "/legal/:page", "destination": "/legal/:page.html" }
  ]
}
